// -*- mode: json -*-

{
	"layer": "top",
	"position": "right",

	"modules-left": [
		"hyprland/workspaces",
		"wlr/taskbar"
	],
	"modules-center": [
		"clock#2",
		"clock#3",
	],
	"modules-right": [
		"custom/left-arrow-dark",
		"pulseaudio",
		"backlight",
//		"network",
		"memory",
		"custom/gpu",
//		"cpu",
		"custom/cpu",
		"custom/left-arrow-dark",
		"custom/bat",
		"tray"
	],

	"hyprland/workspaces": {
		"all-outputs": true,
		"format": "{icon}{name}",
		"format-icons": {
			"active":  "󰄯",
            		"default": "",
           	 	"empty":   "󱥸"
		}		
	},

	"clock#1": {
		"format": "{:%a}",
		"tooltip": false
	},
	"clock#2": {
		"format": "{:%H:%M:%S}",
		"tooltip": false,
		"interval": 1,
	},
	"clock#3": {
		"format": "{:%d%b25}",
		"tooltip": false,
	},

	"pulseaudio": {
		"format": "{icon} {volume:2}%",
		"format-bluetooth": "{icon}  {volume}%",
		"format-muted": "MUTE",
		"format-icons": {
			"headphones": "",
			"default": [
				"",
				""
			]
		},
		"scroll-step": 5,
		"on-click": "pamixer -t",
		"on-click-right": "pavucontrol"
	},
	"memory": {
		"interval": 20,
		"format": " {}%"
	},
	"cpu": {
		"interval": 10,
		"format": "{icon} {usage:2}%",
		"format-icons": [
			""
		]
	},
	"custom/cpu": {
		"interval": 10,
		"exec":"~/.config/waybar/scripts/cpu.sh",
		"return-type": "json",
		"format": "󰻠 {}",
		"tooltip": true
	},
	
	"custom/gpu": {
		"interval": 10,
  		"exec":"~/.config/waybar/scripts/gpu.sh",
		"return-type": "json",
		"tooltip": true,
  		"format": "󰘚 {}",
		"on-click-right": "nvidia-settings"
	},
	"battery": {
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 15
		},
		"format": "{icon} {capacity}%",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		]
	},
	"custom/bat": {
		"interval": 60,
		"exec": "~/.config/waybar/scripts/bat.sh",
		"return-type": "json",
		"format": "{}",
		"tooltip": true
	},
	"backlight": {
		"format": "{icon} {percent}%",
		"format-icons": [
			"",
		 	""
		]
	},
	"disk": {
		"interval": 20,
		"format": "Disk {percentage_used:2}%",
		"path": "/"
	},
	"tray": {
		"icon-size": 20
	},
	"wlr/taskbar": {
        	"format": "{icon}",
        	"icon-size": 20,
        	"on-click-middle": "close",
        	"tooltip-format": "{title}",
        	"ignore-list": [],
        	"on-click": "activate"
	},

	"network": {
		"format-wifi": " {signalStrength}%", 
        	"format-ethernet": " {ipaddr}/{cidr}",
	        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    }
}
